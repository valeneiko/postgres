{
  "files.exclude": {
    // "**/dist": true,
    // "**/node_modules": true,
    "**/coverage": true,
    "**/*.tsbuildinfo": true,
    "**/*.eslintcache": true,
    "**/.tanstack": true
  },
  "files.watcherExclude": {
    "**/dist": true,
    "**/node_modules": true,
    "**/coverage": true,
    "**/*.tsbuildinfo": true,
    "**/.eslintcache": true,
    "**/routeTree.gen.ts": true
  },
  "search.exclude": {
    "**/dist": true,
    "**/node_modules": true,
    "**/coverage": true,
    "**/*.tsbuildinfo": true,
    "**/pnpm-lock.yaml": true,
    "**/.eslintcache": true,
    "**/routeTree.gen.ts": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true,
    "**/pnpm-lock.yaml": true
  },
  // "explorer.excludeGitIgnore": true,
  "files.associations": {
    ".dockerignore": "ignore",
    ".eslintignore": "ignore",
    ".vscodeignore": "ignore"
  },
  "editor.formatOnSave": true,
  "eslint.runtime": "node",
  "eslint.codeActionsOnSave.mode": "all",
  "eslint.useFlatConfig": true,
  "eslint.run": "onSave",
  "eslint.format.enable": false,
  "eslint.lintTask.enable": true,
  "eslint.execArgv": ["--max-old-space-size=8192"],
  "trailing-spaces.trimOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    // "source.fixAll.oxc": "explicit",
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "javascript.preferences.importModuleSpecifier": "shortest"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "javascript.preferences.importModuleSpecifier": "shortest"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "typescript.preferences.importModuleSpecifier": "non-relative"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "typescript.preferences.importModuleSpecifier": "non-relative"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[html]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[dotenv]": {
    "files.insertFinalNewline": false
  },
  "typescript.experimental.useTsgo": true,
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.suggest.paths": true,
  "typescript.preferences.autoImportSpecifierExcludeRegexes": ["^node:test$"],
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.enableTracing": false,
  "typescript.tsserver.maxTsServerMemory": 8192,
  "typescript.tsserver.watchOptions": {
    "watchFile": "useFsEventsOnParentDirectory",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriorityPolling"
  },
  "typescript.tsserver.log": "off",
  "cSpell.words": ["valeneiko", "oxlint"],
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "editor.detectIndentation": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.inlineSuggest.enabled": true,
  "oxc.unusedDisableDirectives": "allow",
  "oxc.path.oxfmt": "node_modules/.bin/oxfmt",
  "oxc.path.oxlint": "node_modules/.bin/oxlint",
  // "oxc.path.tsgolint": "node_modules/.bin/tsgolint",
  "oxc.path.tsgolint": "node_modules/.bin/tsgolint.CMD",
  "oxc.typeAware": true
}
